// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toDbScriptXml > renders CREATE TABLE for both dialects 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<scripts version="1">
  <sql nomeTabela="AD_EXEMPLO" ordem="1" executar="SE_NAO_EXISTIR" tipoObjeto="TABELA" nomeObjeto="AD_EXEMPLO">
    <oracle><![CDATA[CREATE TABLE AD_EXEMPLO (CODIGO NUMBER(10) NOT NULL, NOME VARCHAR2(40), VALOR NUMBER(10,2) DEFAULT 0, ATIVO CHAR(1) DEFAULT 'S' NOT NULL, DTCAD DATE, OBS CLOB, ARQ BLOB, PRIMARY KEY (CODIGO))]]></oracle>
    <mssql><![CDATA[CREATE TABLE AD_EXEMPLO (CODIGO INT NOT NULL, NOME VARCHAR(40), VALOR DECIMAL(10,2) DEFAULT 0, ATIVO CHAR(1) DEFAULT 'S' NOT NULL, DTCAD DATETIME, OBS VARCHAR(MAX), ARQ VARBINARY(MAX), PRIMARY KEY (CODIGO))]]></mssql>
  </sql>
</scripts>
"
`;

exports[`toDbScriptXml > renders every change kind, in a safe order, with no ";" anywhere in the file 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<scripts version="7">
  <sql nomeTabela="AD_ANTIGA" ordem="1" executar="SE_EXISTIR" tipoObjeto="TABELA" nomeObjeto="AD_ANTIGA">
    <oracle><![CDATA[ALTER TABLE AD_ANTIGA RENAME TO AD_EXEMPLO]]></oracle>
    <mssql><![CDATA[EXEC sp_rename 'AD_ANTIGA', 'AD_EXEMPLO']]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="2" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="VELHO">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO RENAME COLUMN VELHO TO NOVO]]></oracle>
    <mssql><![CDATA[EXEC sp_rename 'AD_EXEMPLO.VELHO', 'NOVO', 'COLUMN']]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="3" executar="SEMPRE" tipoObjeto="CONSTRAINT" nomeObjeto="AD_EXEMPLO">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO DROP PRIMARY KEY]]></oracle>
    <mssql><![CDATA[DECLARE @pk SYSNAME, @sql NVARCHAR(400) SELECT @pk = name FROM sys.key_constraints WHERE parent_object_id = OBJECT_ID('AD_EXEMPLO') AND type = 'PK' IF @pk IS NOT NULL BEGIN SET @sql = N'ALTER TABLE AD_EXEMPLO DROP CONSTRAINT ' + QUOTENAME(@pk) EXEC(@sql) END]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="4" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="REMOVER">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO DROP COLUMN REMOVER]]></oracle>
    <mssql><![CDATA[DECLARE @df SYSNAME, @sql NVARCHAR(400) SELECT @df = dc.name FROM sys.default_constraints dc JOIN sys.columns c ON c.object_id = dc.parent_object_id AND c.column_id = dc.parent_column_id WHERE dc.parent_object_id = OBJECT_ID('AD_EXEMPLO') AND c.name = 'REMOVER' IF @df IS NOT NULL BEGIN SET @sql = N'ALTER TABLE AD_EXEMPLO DROP CONSTRAINT ' + QUOTENAME(@df) EXEC(@sql) END ALTER TABLE AD_EXEMPLO DROP COLUMN REMOVER]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="5" executar="SE_NAO_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="EXTRA">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO ADD (EXTRA VARCHAR2(5) DEFAULT 'N' NOT NULL)]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ADD EXTRA VARCHAR(5) DEFAULT 'N' NOT NULL]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="6" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="NOME">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO MODIFY (NOME VARCHAR2(60))]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ALTER COLUMN NOME VARCHAR(60) NOT NULL]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="7" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="QTD">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO MODIFY (QTD NUMBER(12,2))]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ALTER COLUMN QTD DECIMAL(12,2) NULL]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="8" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="CURTO">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO MODIFY (CURTO VARCHAR2(20))]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ALTER COLUMN CURTO VARCHAR(20) NULL]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="9" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="NOME">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO MODIFY (NOME NOT NULL)]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ALTER COLUMN NOME VARCHAR(60) NOT NULL]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="10" executar="SE_EXISTIR" tipoObjeto="COLUNA" nomeObjeto="NOME">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO MODIFY (NOME DEFAULT 'X')]]></oracle>
    <mssql><![CDATA[DECLARE @df SYSNAME, @sql NVARCHAR(400) SELECT @df = dc.name FROM sys.default_constraints dc JOIN sys.columns c ON c.object_id = dc.parent_object_id AND c.column_id = dc.parent_column_id WHERE dc.parent_object_id = OBJECT_ID('AD_EXEMPLO') AND c.name = 'NOME' IF @df IS NOT NULL BEGIN SET @sql = N'ALTER TABLE AD_EXEMPLO DROP CONSTRAINT ' + QUOTENAME(@df) EXEC(@sql) END ALTER TABLE AD_EXEMPLO ADD DEFAULT 'X' FOR NOME]]></mssql>
  </sql>
  <sql nomeTabela="AD_EXEMPLO" ordem="11" executar="SEMPRE" tipoObjeto="CONSTRAINT" nomeObjeto="AD_EXEMPLO">
    <oracle><![CDATA[ALTER TABLE AD_EXEMPLO ADD PRIMARY KEY (CODIGO, NOME)]]></oracle>
    <mssql><![CDATA[ALTER TABLE AD_EXEMPLO ADD PRIMARY KEY (CODIGO, NOME)]]></mssql>
  </sql>
</scripts>
"
`;
