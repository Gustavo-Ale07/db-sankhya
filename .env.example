# DB-Sankhya configuration. Copy to .env (or .env.production) and fill in the empty values.
# Every value here is a placeholder or a safe default; never commit a real one.
# Production (NODE_ENV=production, the Docker image default, or APP_ENV=production) refuses to
# start while a required secret is empty, weak or a placeholder. See docs/deployment.md.

# Application
APP_ENV=development
# Public URL users open in the browser (CSRF origin checks, cookies).
# Development: the Vite dev server. Production requires https:// (except localhost).
APP_URL=http://localhost:5173
# Alias of APP_URL, used only when APP_URL is empty.
PUBLIC_URL=
# Extra origins allowed to send state-changing requests (comma-separated, scheme://host[:port]).
# APP_URL's origin is always trusted; leave empty unless another origin really needs access.
TRUSTED_ORIGINS=

# Set by the Docker image or by compose; only uncomment to run the API outside them.
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3001
# MIGRATIONS_DIR=
# STATIC_DIR=
# Shown in the UI footer and GET /api/meta (the commit is usually a build argument).
# APP_VERSION=
# GIT_COMMIT=

# Application database
# Empty: in-memory PGlite in development; compose builds it from POSTGRES_* below.
DATABASE_URL=

# Optional cache / queue
# Reserved; not used by the current version.
REDIS_URL=

# Authentication / encryption
# Signs plan tokens. At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Legacy name of AUTH_SECRET, read only when AUTH_SECRET is empty.
# SESSION_SECRET=
# Encrypts connection secrets at rest: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32. Production refuses to start without it.
# Back it up apart from the database dumps: losing it means re-entering every stored connection
# secret (docs/operations.md).
ENCRYPTION_KEY=

# Sankhya integration
# live: real gateway. mock: fictitious in-process gateway with demo data.
# Empty means mock in development; production requires live (or mock together with DEMO_MODE=true).
SANKHYA_MODE=
DEMO_MODE=false
# Optional default connection read from the environment (never stored in the database).
# Leave all four empty to start without Sankhya: the connection is shown as not configured,
# and connections can be registered in the admin panel instead.
SANKHYA_BASE_URL=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
# PRODUCTION, HOMOLOGATION or SANDBOX (default PRODUCTION, the most restrictive).
SANKHYA_ENVIRONMENT=PRODUCTION
# oracle or mssql: the dialect of the Sankhya database behind the gateway.
SANKHYA_DIALECT=oracle
# Gateway hosts connections may use (exact names, comma-separated).
SANKHYA_ALLOWED_HOSTS=api.sankhya.com.br,api.sandbox.sankhya.com.br
SANKHYA_TIMEOUT_MS=60000
# Gateway request budget per minute (at most 1000).
SANKHYA_RATE_PER_MINUTE=300
# Most rows a read returns; policy rules can only lower it.
SANKHYA_MAX_ROWS=1000

# Write switches (docs/operations.md). With these defaults no write reaches the ERP.
# GLOBAL_WRITE_ENABLED=false stops every planned write and business action. Statements run
# directly in the local scratch database (scratch editor, materialization) are not covered; they
# never reach the ERP. An administrator can also turn writes off at runtime (Segurança page); the
# runtime switch can never turn them on.
GLOBAL_WRITE_ENABLED=false
# WRITE_TO_SANKHYA=false stops writes to Sankhya tables.
WRITE_TO_SANKHYA=false
# SAFE_MODE=true stops writes on PRODUCTION connections.
SAFE_MODE=true
# Business actions (typed gateway services, see docs/sankhya.md) allowed on live connections,
# comma-separated action ids. Empty disables every action on a live connection. Their request
# bodies were validated only against the bundled mock: test in HOMOLOGATION first.
BUSINESS_ACTIONS_ENABLED=
# Lifetime of a previewed execution plan, in seconds (30 to 3600).
PLAN_TTL_SECONDS=300
# Lifetime of a plan that needs a second person's approval, in minutes (its approval expires with it).
APPROVAL_TTL_MINUTES=60

# Scratch (temporary tables per workspace)
SCRATCH_MAX_WORKSPACES=20
SCRATCH_MAX_ROWS=100000
SCRATCH_MAX_TABLES=20
SCRATCH_TTL_MINUTES=60
SCRATCH_STATEMENT_TIMEOUT_MS=10000
MATERIALIZE_MAX_ROWS=5000
# How long (s) an incomplete Sankhya catalog is served before the dictionary is read again.
METADATA_DEGRADED_TTL_SECONDS=600
# Pages of one dictionary read (TDDTAB, TDDCAM) before it is reported as cut (1-1000).
METADATA_MAX_PAGES=100
# Prefixes of custom (Add-on) tables; every other table is native and never altered.
CUSTOM_TABLE_PREFIXES=AD_

# Logging (debug and trace are refused in production)
LOG_LEVEL=info

# Network
# Host interface/port compose publishes the app on. Keep 127.0.0.1 behind a reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=3001
# Which peers may set X-Forwarded-For: addresses, CIDRs or names (loopback, uniquelocal).
TRUST_PROXY=loopback,uniquelocal

# PostgreSQL for compose (use URL-safe characters in the password).
POSTGRES_DB=dbsankhya
POSTGRES_USER=dbsankhya
POSTGRES_PASSWORD=change-me-db-password

# Sessions and login
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# First administrator. There is no default password. With an empty users table and no
# BOOTSTRAP_ADMIN_EMAIL, the app logs a one-time bootstrap token once at warn level
# ("bootstrap token: ...", valid BOOTSTRAP_TOKEN_TTL_MINUTES) for POST /api/auth/bootstrap.
# Setting BOOTSTRAP_ADMIN_EMAIL selects the admin CLI instead:
#   node dist/admin.mjs bootstrap --email <e-mail>   (prints a one-time password)
# BOOTSTRAP_ADMIN_PASSWORD is no longer supported: the app refuses to start when it is set.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_TOKEN_TTL_MINUTES=30
# Role keys of that first user (comma-separated). ADMIN administers the tool but holds no DATA.*
# permission; add OPERATOR (ADMIN,OPERATOR) if this account must also write ERP data, which then
# still needs policy ALLOW rules and the write switches above.
BOOTSTRAP_ADMIN_ROLES=ADMIN
