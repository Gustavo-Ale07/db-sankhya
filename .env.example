# Application
APP_ENV=development
APP_URL=http://localhost:3000

# Application database
DATABASE_URL=

# Optional cache / queue
REDIS_URL=

# Authentication / encryption
AUTH_SECRET=
ENCRYPTION_KEY=

# Sankhya integration
SANKHYA_BASE_URL=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=

# Safe defaults
SAFE_MODE=true
GLOBAL_WRITE_ENABLED=false

# Logging
LOG_LEVEL=info
