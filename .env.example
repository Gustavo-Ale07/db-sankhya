# Application
APP_ENV=development
# Public URL users open in the browser (CSRF origin checks, cookies).
# Development: the Vite dev server. Production requires https://.
APP_URL=http://localhost:5173
# Alias of APP_URL, used only when APP_URL is empty.
PUBLIC_URL=
# Extra origins allowed to send state-changing requests (comma-separated, scheme://host[:port]).
# APP_URL's origin is always trusted; leave empty unless another origin really needs access.
TRUSTED_ORIGINS=

# Application database
# Empty: in-memory PGlite in development; compose builds it from POSTGRES_* below.
DATABASE_URL=

# Optional cache / queue
# Reserved; not used by the current version.
REDIS_URL=

# Authentication / encryption
# Signs sessions and confirmation tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Encrypts connection secrets at rest: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32. Production refuses to start without it.
ENCRYPTION_KEY=

# Sankhya integration
# live: real gateway. mock: fictitious in-process gateway with demo data.
# Empty means mock in development; production requires live (or mock together with DEMO_MODE=true).
SANKHYA_MODE=
DEMO_MODE=false
# Optional default connection read from the environment (never stored in the database).
# Leave all four empty to start without Sankhya: the connection is shown as not configured,
# and connections can be registered in the admin panel instead.
SANKHYA_BASE_URL=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
# PRODUCTION, HOMOLOGATION or SANDBOX (default PRODUCTION, the most restrictive).
SANKHYA_ENVIRONMENT=PRODUCTION
# oracle or mssql: the dialect of the Sankhya database behind the gateway.
SANKHYA_DIALECT=oracle
# Gateway hosts connections may use (exact names, comma-separated).
SANKHYA_ALLOWED_HOSTS=api.sankhya.com.br,api.sandbox.sankhya.com.br
SANKHYA_TIMEOUT_MS=60000
SANKHYA_RATE_PER_MINUTE=300

# Safe defaults
# SAFE_MODE=true keeps the strictest checks on. GLOBAL_WRITE_ENABLED and WRITE_TO_SANKHYA are kill
# switches: while either is false, no mutation reaches Sankhya (reads keep working).
SAFE_MODE=true
GLOBAL_WRITE_ENABLED=false
WRITE_TO_SANKHYA=false
# Lifetime of a previewed execution plan, in seconds.
PLAN_TTL_SECONDS=300
# Lifetime of a plan that needs a second person's approval, in minutes (its approval expires with it).
APPROVAL_TTL_MINUTES=60

# Scratch (temporary tables per workspace)
SCRATCH_MAX_WORKSPACES=20
SCRATCH_MAX_ROWS=100000
SCRATCH_MAX_TABLES=20
SCRATCH_TTL_MINUTES=60
SCRATCH_STATEMENT_TIMEOUT_MS=10000
MATERIALIZE_MAX_ROWS=5000
# Prefixes of custom (Add-on) tables; every other table is native and never altered.
CUSTOM_TABLE_PREFIXES=AD_

# Logging
LOG_LEVEL=info

# =============================================================================
# Transitional settings — used by the current code while the migration to the
# Sankhya gateway is in progress (see docs/migration-plan.md). They are renamed
# or removed as each stage lands. Placeholders are refused in production.
# =============================================================================

# Host interface/port compose publishes the app on. Keep 127.0.0.1 behind a reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=3001
# Which peers may set X-Forwarded-For: addresses, CIDRs or names (loopback, uniquelocal).
TRUST_PROXY=loopback,uniquelocal

# PostgreSQL for compose (use URL-safe characters in the password).
POSTGRES_DB=dbsankhya
POSTGRES_USER=dbsankhya
POSTGRES_PASSWORD=change-me-db-password

SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# First administrator. There is no default password. With an empty users table and no
# BOOTSTRAP_ADMIN_EMAIL, the app logs a one-time bootstrap token once at warn level
# ("bootstrap token: ...", valid BOOTSTRAP_TOKEN_TTL_MINUTES) for POST /api/auth/bootstrap.
# Setting BOOTSTRAP_ADMIN_EMAIL selects the admin CLI instead:
#   node dist/admin.mjs bootstrap --email <e-mail>   (prints a one-time password)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_TOKEN_TTL_MINUTES=30
# Role keys of that first user (comma-separated). ADMIN administers the tool. Mutations are
# refused for every role (OPERATOR included) until the write path ships (Stage 11).
BOOTSTRAP_ADMIN_ROLES=ADMIN

