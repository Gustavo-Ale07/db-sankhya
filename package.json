{
  "name": "db-sankhya",
  "version": "0.1.0",
  "private": true,
  "description": "SQL explorer for the Sankhya ERP gateway with read-only guards, saved queries and audit logs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dbx/api --filter @dbx/web dev",
    "build": "pnpm --filter @dbx/web build && pnpm --filter @dbx/api build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @dbx/e2e test",
    "db:generate": "pnpm --filter @dbx/database generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
